   // Decide whether we are opening a normal window or an incognito window.
   Profile* calling_profile = Profile::FromBrowserContext(browser_context());
   windows_util::IncognitoResult incognito_result =
@@ -2118,6 +2180,42 @@ ExtensionFunction::ResponseAction TabsCreateFunction::Run() {
     }
   }
 
+#if BUILDFLAG(ENABLE_CEF)
+  // Alloy style browsers have no native tab strip or window. If the profile
+  // has one, the client application decides where the tab goes
+  // (CefLifeSpanHandler::OnExtensionCreateTab). If the client does not
+  // handle it, the call fails; no native window is opened.
+  {
+    cef::ExtensionCreateTabResult cef_result = cef::RequestExtensionCreateTab(
+        Profile::FromBrowserContext(browser_context()),
+        extension() ? extension()->id() : std::string(), validated_url_,
+        create_properties.window_id.value_or(extension_misc::kUnknownWindowId),
+        active_.value_or(true), /*new_window=*/false, GetSenderWebContents());
+    if (cef_result.status == cef::ExtensionCreateTabStatus::kRefused) {
+      return RespondNow(Error(std::move(cef_result.error)));
+    }
+    if (cef_result.status == cef::ExtensionCreateTabStatus::kHandled) {
+      if (cef_result.contents) {
+        return RespondNow(WithArguments(
+            tabs_internal::CreateTabObjectHelper(
+                cef_result.contents, extension(), source_context_type(),
+                /*browser=*/nullptr, /*tab_index=*/-1)
+                .ToValue()));
+      }
+      // The client opened the tab but did not return its browser. Answer with
+      // a placeholder; the real tab arrives through tabs.onCreated.
+      api::tabs::Tab placeholder;
+      placeholder.index = -1;
+      placeholder.window_id = -1;
+      placeholder.highlighted = false;
+      placeholder.active = false;
+      placeholder.pinned = false;
+      placeholder.incognito = browser_context()->IsOffTheRecord();
+      return RespondNow(WithArguments(placeholder.ToValue()));
+    }
+  }
+#endif  // BUILDFLAG(ENABLE_CEF)
+
