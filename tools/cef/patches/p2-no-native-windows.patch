 #endif
 
+#if BUILDFLAG(ENABLE_CEF)
+  // Alloy style: no native window. The client application opens the window
+  // (CefLifeSpanHandler::OnExtensionCreateTab with new_window = true).
+  if (cef::HasAlloyBrowser(Profile::FromBrowserContext(browser_context()))) {
+    if (create_data_ && create_data_->tab_id) {
+      // Moving an existing tab into a new window is not supported.
+      return RespondNow(Error("tabId is not supported for windows.create."));
+    }
+    cef::ExtensionCreateTabResult cef_result = cef::RequestExtensionCreateTab(
+        Profile::FromBrowserContext(browser_context()),
+        extension() ? extension()->id() : std::string(),
+        urls_.empty() ? GURL() : urls_[0], extension_misc::kUnknownWindowId,
+        /*active=*/true, /*new_window=*/true, GetSenderWebContents());
+    if (cef_result.status == cef::ExtensionCreateTabStatus::kRefused) {
+      return RespondNow(Error(std::move(cef_result.error)));
+    }
+    if (cef_result.status == cef::ExtensionCreateTabStatus::kHandled) {
+      // Further URLs become tabs of the window the client just opened.
+      int new_window_id = extension_misc::kUnknownWindowId;
+      if (cef_result.contents) {
+        new_window_id = ExtensionTabUtil::GetWindowIdOfTab(cef_result.contents);
+      }
+      for (size_t i = 1; i < urls_.size(); ++i) {
+        cef::ExtensionCreateTabResult more = cef::RequestExtensionCreateTab(
+            Profile::FromBrowserContext(browser_context()),
+            extension() ? extension()->id() : std::string(), urls_[i],
+            new_window_id, /*active=*/false, /*new_window=*/false,
+            GetSenderWebContents());
+        if (more.status == cef::ExtensionCreateTabStatus::kRefused) {
+          return RespondNow(Error(std::move(more.error)));
+        }
+      }
+      WindowController* new_window_controller =
+          new_window_id > 0 ? ExtensionTabUtil::GetControllerInProfileWithId(
+                                  Profile::FromBrowserContext(browser_context()),
+                                  new_window_id,
+                                  include_incognito_information(), nullptr)
+                            : nullptr;
+      if (new_window_controller) {
+        return RespondNow(WithArguments(
+            new_window_controller->CreateWindowValueForExtension(
+                extension(), WindowController::kPopulateTabs,
+                source_context_type())));
+      }
+      // The client opened the window but did not return a browser registered
+      // with CefBrowserHost::SetExtensionTabInfo. Answer with a placeholder.
+      base::DictValue placeholder;
+      placeholder.Set(extension_misc::kId, extension_misc::kUnknownWindowId);
+      placeholder.Set("type", "normal");
+      placeholder.Set("state", "normal");
+      placeholder.Set("focused", false);
+      placeholder.Set("incognito", browser_context()->IsOffTheRecord());
+      placeholder.Set("alwaysOnTop", false);
+      return RespondNow(WithArguments(std::move(placeholder)));
+    }
+  }
+#endif  // BUILDFLAG(ENABLE_CEF)
