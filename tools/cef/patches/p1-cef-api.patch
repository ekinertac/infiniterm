+  /// returning the last focused window from getLastFocused. Changes fire
+  /// chrome.windows.onFocusChanged. Safe to call from any thread.
+  ///
+  /*--cef(added=experimental)--*/
+  static void SetExtensionFocusedWindow(int window_id);
+#endif
