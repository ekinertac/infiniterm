+#if BUILDFLAG(ENABLE_CEF)
+void TabsQueryFunction::AppendAlloyTabs(base::ListValue& result,
+                                        const URLPatternSet& url_patterns,
+                                        const std::string& window_type,
+                                        int window_id,
+                                        int tab_index) {
+  // Alloy windows are always normal windows.
+  if (!window_type.empty() &&
+      window_type != tabs::ToString(tabs::WindowType::kNormal)) {
+    return;
+  }
+  if (extension() && extension()->is_platform_app()) {
+    return;
+  }
+
+  WindowController* current = cef::GetAlloyCurrentWindowController(this);
+  const int current_window_id = current ? current->GetWindowId() : -1;
+  WindowController* last_focused =
+      cef::GetAlloyLastFocusedWindowController(this);
+  const int last_focused_window_id =
+      last_focused ? last_focused->GetWindowId() : -1;
+
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  for (content::WebContents* contents :
+       cef::GetAlloyTabs(profile, include_incognito_information())) {
+    std::optional<cef::AlloyTabInfo> info = cef::GetAlloyTabInfo(contents);
+    if (!info) {
+      continue;
+    }
+    // Note: `window_id` may be -1 or -2, which indicate unknown and current
+    // windows.
+    if (window_id >= 0 && window_id != info->window_id) {
+      continue;
+    }
+    if (window_id == extension_misc::kCurrentWindowId &&
+        info->window_id != current_window_id) {
+      continue;
+    }
+    if (!MatchesBool(query_info_.current_window,
+                     info->window_id == current_window_id) ||
+        !MatchesBool(query_info_.last_focused_window,
+                     info->window_id == last_focused_window_id)) {
+      continue;
+    }
+    if (tab_index > -1 && info->index != tab_index) {
+      continue;
+    }
+    if (!MatchesAlloyTab(contents, info->active, url_patterns)) {
+      continue;
+    }
+    result.Append(
+        ExtensionTabUtil::CreateTabObject(
+            contents,
+            ExtensionTabUtil::GetScrubTabBehavior(
+                extension(), source_context_type(), contents),
+            extension(), /*tab_list=*/nullptr, info->index)
+            .ToValue());
+  }
+}
+
+// Same filters as MatchesTab, for a tab without TabInterface, tab lifecycle
+// helper or audible helper. Such a tab is never pinned, grouped, split, frozen
+// or discarded, and is always auto-discardable.
+bool TabsQueryFunction::MatchesAlloyTab(
+    content::WebContents* web_contents,
+    bool active,
+    const URLPatternSet& target_url_patterns) {
+  if (!MatchesBool(query_info_.highlighted, active) ||
+      !MatchesBool(query_info_.active, active) ||
+      !MatchesBool(query_info_.pinned, false) ||
+      !MatchesBool(query_info_.audible, web_contents->IsCurrentlyAudible()) ||
+      !MatchesBool(query_info_.frozen, false) ||
+      !MatchesBool(query_info_.discarded, false) ||
+      !MatchesBool(query_info_.auto_discardable, true) ||
+      !MatchesBool(query_info_.muted, web_contents->IsAudioMuted())) {
+    return false;
+  }
+  if (query_info_.group_id.has_value() && query_info_.group_id.value() != -1) {
+    return false;
+  }
+  if (query_info_.split_view_id.has_value() &&
+      query_info_.split_view_id.value() != -1) {
+    return false;
+  }
+
+  bool check_title = query_info_.title && !query_info_.title->empty();
+  if (check_title || !target_url_patterns.is_empty()) {
+    // Same privilege rule as MatchesTab.
+    if (!extension_->permissions_data()->HasAPIPermissionForTab(
+            ExtensionTabUtil::GetTabId(web_contents),
+            mojom::APIPermissionID::kTab) &&
+        !extension_->permissions_data()->HasHostPermission(
+            web_contents->GetURL())) {
+      return false;
+    }
+    if (check_title &&
+        !base::MatchPattern(web_contents->GetTitle(),
+                            base::UTF8ToUTF16(*query_info_.title))) {
+      return false;
+    }
+    if (!target_url_patterns.is_empty() &&
+        !target_url_patterns.MatchesURL(web_contents->GetURL())) {
+      return false;
+    }
+  }
+
+  return query_info_.status == tabs::TabStatus::kNone ||
+         query_info_.status == ExtensionTabUtil::GetLoadingStatus(web_contents);
+}
+#endif  // BUILDFLAG(ENABLE_CEF)
+
