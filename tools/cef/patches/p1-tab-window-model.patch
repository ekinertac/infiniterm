+#if BUILDFLAG(ENABLE_CEF)
+void TabsEventRouter::DispatchAlloyTabCreated(content::WebContents* contents,
+                                              bool active) {
+  DispatchTabCreatedEvent(contents, active);
+}
+
+void TabsEventRouter::DispatchAlloyTabUpdated(
+    content::WebContents* contents,
+    std::set<std::string> changed_property_names) {
+  DispatchTabUpdatedEvent(contents, std::move(changed_property_names));
+}
+
+void TabsEventRouter::DispatchAlloyTabActivated(
+    content::WebContents* contents) {
+  // The onActivated event takes one argument: {windowId, tabId}.
+  base::DictValue object_args;
+  object_args.Set(tabs_constants::kWindowIdKey,
+                  ExtensionTabUtil::GetWindowIdOfTab(contents));
+  object_args.Set(kTabIdKey, ExtensionTabUtil::GetTabId(contents));
+  base::ListValue args;
+  args.Append(std::move(object_args));
+  DispatchEvent(Profile::FromBrowserContext(contents->GetBrowserContext()),
+                events::TABS_ON_ACTIVATED, api::tabs::OnActivated::kEventName,
+                std::move(args), EventRouter::UserGestureState::kUnknown);
+}
+
+void TabsEventRouter::DispatchAlloyTabRemoved(Profile* profile,
+                                              int tab_id,
+                                              int window_id,
+                                              bool is_window_closing) {
+  base::ListValue args;
+  args.Append(tab_id);
+  base::DictValue object_args;
+  object_args.Set(tabs_constants::kWindowIdKey, window_id);
+  object_args.Set(tabs_constants::kIsWindowClosingKey, is_window_closing);
+  args.Append(std::move(object_args));
+  DispatchEvent(profile, events::TABS_ON_REMOVED,
+                api::tabs::OnRemoved::kEventName, std::move(args),
+                EventRouter::UserGestureState::kUnknown);
+}
+#endif  // BUILDFLAG(ENABLE_CEF)
+
 bool TabsEventRouter::ShouldTrackBrowser(BrowserWindowInterface& browser) {
