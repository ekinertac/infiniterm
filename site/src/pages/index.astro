---
// The landing page at the site root. Not a Starlight page: the docs live
// under guide/ and reference/ with Starlight's chrome, and this page has its
// own. Its one idea is that the page IS a piece of the canvas: a light dot
// grid with dark terminal cards on it, and the four state colours are the
// app's own (infiniterm-ui/src/chrome.rs: agent_working, _waiting, _failed,
// _done). Far cards draw their text as bars, the way the app does below the
// legible size. The film is typereel's HTML (public/film.html, ?play mode).
// Fonts are self-hosted through fontsource so the page asks nothing of
// Google, which a "no telemetry" product page should not.
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// One app, every feature, free for personal use; working with it needs a
// commercial licence, one per person, one time (Ekin, 2026-09-30, replacing
// the Lite/Pro split of ekinertac/notes#50). Sold through Lemon Squeezy:
// until the product exists BUY_URL is empty and the button says so rather
// than pointing nowhere.
const BUY_URL = '';
const PRICE = '$29';
const INSTALL = 'curl -fsSL https://infiniterm.app/install.sh | sh';
const BREW = 'brew install --cask ekinertac/tap/infiniterm';
const DOWNLOAD_URL = 'https://github.com/ekinertac/infiniterm/releases/latest';
const SOURCE_URL = 'https://github.com/ekinertac/infiniterm';

// The hero canvas, in reading order. `state` is what the card settles on;
// `lines` are bar widths in characters, since these cards are "far away".
type State = 'working' | 'waiting' | 'failed' | 'done' | 'none';
const heroCards: { name: string; state: State; lines: number[]; near?: string[] }[] = [
  { name: 'api', state: 'working', lines: [14, 22, 9, 30, 18, 26, 12] },
  {
    name: 'claude',
    state: 'waiting',
    lines: [],
    near: ['⏺ Update(src/router.rs)', '', 'Do you want to make this edit', 'to router.rs?', '', '❯ 1. Yes', '  2. Yes, and don’t ask again', '  3. No'],
  },
  { name: 'claude', state: 'done', lines: [24, 11, 31, 16, 8, 27] },
  { name: 'web', state: 'none', lines: [9, 18, 13, 22] },
  { name: 'pi', state: 'working', lines: [28, 15, 21, 10, 33, 19, 7] },
  { name: 'tests', state: 'failed', lines: [17, 29, 12, 25, 9, 20] },
  { name: 'logs', state: 'none', lines: [31, 30, 32, 29, 31, 30, 28] },
  { name: 'claude', state: 'working', lines: [12, 26, 19, 8, 23, 15] },
  { name: 'db', state: 'none', lines: [10, 16, 7] },
  { name: 'infra', state: 'done', lines: [20, 13, 27, 18, 11] },
  { name: 'docs', state: 'none', lines: [25, 14, 22] },
  { name: 'claude', state: 'working', lines: [16, 30, 11, 24, 20, 9, 13] },
  { name: 'ssh', state: 'none', lines: [19, 8, 26] },
  { name: 'pi', state: 'done', lines: [22, 14, 30, 10] },
  { name: 'build', state: 'working', lines: [30, 28, 31, 29, 30] },
];

const states = [
  {
    key: 'working',
    name: 'Working',
    says: 'An agent is mid-turn, or a command has been running for 5 seconds.',
    screen: ['~/Code/api ❯ cargo build --release', '   Compiling tokio v1.47.1', '   Compiling api v0.3.0', '   Building [=====>   ] 212/297'],
  },
  {
    key: 'waiting',
    name: 'Waiting on you',
    says: 'It asked for permission, or asked you a question.',
    screen: ['Bash(rm -rf target/)', '', 'Do you want to proceed?', '❯ 1. Yes', '  2. No, and tell Claude what to do'],
  },
  {
    key: 'failed',
    name: 'Failed',
    says: 'A command exited non-zero, or the turn ended in an error.',
    screen: ['~/Code/web ❯ npm test', '', ' FAIL  src/cart.test.ts', '  ✕ applies the discount', '', 'Tests: 1 failed, 41 passed'],
  },
  {
    key: 'done',
    name: 'Done',
    says: 'The turn finished. It stays green until the next one starts.',
    screen: ['⏺ The migration is in place and the', '  three failing tests pass now.', '', '> _'],
  },
];

// The title bar's workspace tabs: one dot per card in reading order, grey
// until the card has something to say. The active tab shows none lit,
// as in the app (the cards are right there).
const workspaces: { name: string; active?: boolean; dots: State[] }[] = [
  { name: 'api', active: true, dots: ['none', 'none', 'none', 'none'] },
  { name: 'web', dots: ['working', 'none', 'waiting', 'none', 'none'] },
  { name: 'infra', dots: ['done', 'none', 'failed'] },
  { name: 'notes', dots: ['none', 'none'] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>infiniterm</title>
    <meta name="description" content="Terminal cards on an infinite canvas for macOS. Each card's border shows whether the agent in it is working, waiting on you, failed or done." />
    <link rel="icon" href={`${base}favicon.png`} />
    <meta property="og:title" content="infiniterm" />
    <meta property="og:description" content="Terminal cards on an infinite canvas for macOS. Each card's border shows whether the agent in it is working, waiting on you, failed or done." />
    <meta property="og:url" content="https://infiniterm.app/" />
    <meta property="og:image" content="https://infiniterm.app/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top">
      <a class="mark" href={base}><img src={`${base}favicon.png`} alt="" width="28" height="28" />infiniterm</a>
      <nav>
        <a href={`${base}guide/install/`}>Docs</a>
        <a href="#pricing">Pricing</a>
        <a href={DOWNLOAD_URL}>Download</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <h1>See which agent needs you without opening a single tab.</h1>
          <p class="lede">
            infiniterm puts every terminal on one zoomable canvas. Each card keeps its place, and its border says what the
            agent inside is doing: working, waiting on you, failed, or done.
          </p>
          <div class="methods" role="tablist" aria-label="Install with">
            <button type="button" role="tab" aria-selected="true" aria-controls="m-script" id="t-script">Script</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="m-brew" id="t-brew" tabindex="-1">Homebrew</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="m-dmg" id="t-dmg" tabindex="-1">DMG</button>
          </div>
          <div class="install" role="tabpanel" id="m-script" aria-labelledby="t-script">
            <code>{INSTALL}</code>
            <button type="button" class="copy" aria-label="Copy the install command">Copy</button>
          </div>
          <div class="install" role="tabpanel" id="m-brew" aria-labelledby="t-brew" hidden>
            <code>{BREW}</code>
            <button type="button" class="copy" aria-label="Copy the Homebrew command">Copy</button>
          </div>
          <div class="install dmg" role="tabpanel" id="m-dmg" aria-labelledby="t-dmg" hidden>
            <span>Signed and notarized. Drag it into Applications.</span>
            <a href={DOWNLOAD_URL}>Download</a>
          </div>
          <p class="fine">
            macOS 13 or later on Apple Silicon. Free for personal use, <a href="#pricing">$29 for work</a>.
          </p>
        </div>

        <div class="hero-canvas" aria-hidden="true">
          {
            heroCards.map((c, i) => (
              <div class={`card s-${c.state}${c.near ? ' near' : ''}`} style={`--i:${i}`}>
                <span class="label">#{i + 1} {c.name}</span>
                {c.near ? (
                  <pre>{c.near.join('\n')}</pre>
                ) : (
                  <div class="bars">
                    {c.lines.map((w) => (
                      <i style={`width:${w * 3}%`} />
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <section class="film">
        <div class="stage">
          <iframe data-src={`${base}film.html?play`} title="infiniterm in 65 seconds"></iframe>
          <button type="button" class="play" aria-label="Play the 65-second film">
            <span class="play-icon" aria-hidden="true"></span>
            <span>Play the film <span class="len">65 s</span></span>
          </button>
        </div>
      </section>

      <section class="shot">
        <figure>
          <img src={`${base}canvas.png`} width="1600" height="1452" loading="lazy" alt="An infiniterm window at 19% zoom: 33 terminal cards in groups and loose on a dark canvas, their borders violet, green and yellow by state, three workspace tabs with a row of dots each." />
          <figcaption>A real canvas: 33 cards at 19% zoom, grouped and loose, the borders showing which agents are working, done or waiting. Each workspace tab carries a dot per card.</figcaption>
        </figure>
      </section>

      <section class="states">
        <h2>Four colours, because there are four questions.</h2>
        <p class="section-lede">
          Claude Code, Codex, OpenCode and Pi report through hooks. Any other command reports through zsh, so a long build goes violet and
          then green, and a failing one goes red. A shell doing nothing has no colour at all.
        </p>
        <div class="state-row">
          {
            states.map((s) => (
              <figure class={`state s-${s.key}`}>
                <div class="card">
                  <pre>{s.screen.join('\n')}</pre>
                </div>
                <figcaption>
                  <strong>{s.name}</strong>
                  <span>{s.says}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="calm split">
        <div>
          <h2>Nothing flashes. Nothing steals focus.</h2>
          <p>
            There are no notifications and no bouncing icons. You look when you are ready, see which cards changed colour,
            and go there. Other workspaces tell you from their tab: one dot per card, in the order the cards sit, lit in
            that card's colour.
          </p>
        </div>
        <div class="tabs" aria-hidden="true">
          {
            workspaces.map((w) => (
              <div class={`tab${w.active ? ' active' : ''}`}>
                <span>{w.name}</span>
                <span class="dots">
                  {w.dots.map((d) => (
                    <i class={`d-${d}`} />
                  ))}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="kinds">
        <h2>The rest of the work sits on the same canvas.</h2>
        <dl>
          <div><dt>Editor cards</dt><dd>Syntax highlighting for 17 languages, a file tree, find and replace. No LSP, on purpose.</dd></div>
          <div><dt>Diff cards</dt><dd><code>ift diff</code> shows your changes against HEAD, with a blame gutter on <kbd>Cmd</kbd> <kbd>B</kbd>.</dd></div>
          <div><dt>Transcript cards</dt><dd>A Claude Code or Pi session as turns, tool calls folded, following along while it runs.</dd></div>
          <div><dt>Browser cards</dt><dd>Chromium with the Claude in Chrome extension, so an agent can drive a browser that lives next to it.</dd></div>
          <div><dt>Shells that outlive the window</dt><dd>Each card's shell runs under its own small daemon. Quit the app and they keep running; reopen it and they are back.</dd></div>
        </dl>
      </section>

      <section class="keys split">
        <div>
          <h2>Cmd is the app's. Everything else is your shell's.</h2>
          <p>Ctrl, Alt and bare keys go to the terminal untouched, so vim, tmux and your readline habits keep working. Every action is a command, so nothing needs the mouse.</p>
          <p><a href={`${base}reference/keys/`}>All keys</a></p>
        </div>
        <ul>
          <li><span><kbd>Cmd</kbd> <kbd>T</kbd></span> new card, placed where you can predict</li>
          <li><span><kbd>Cmd</kbd> <kbd>Alt</kbd> <kbd>←</kbd></span> the card to the left</li>
          <li><span><kbd>Ctrl</kbd> <kbd>Tab</kbd></span> the cards you worked in, most recent first</li>
          <li><span><kbd>Cmd</kbd> <kbd>2</kbd></span> fit every card in the window</li>
          <li><span><kbd>Cmd</kbd> <kbd>Shift</kbd> <kbd>P</kbd></span> every command, by name</li>
        </ul>
      </section>

      <section class="nots">
        <h2>What it does not have.</h2>
        <p class="big">No Electron. No account. No telemetry.</p>
        <p>
          A native app in Rust. The only request it makes on its own is the update check, a plain GET with nothing about
          you in it. <a href={`${base}guide/configuration/#what-the-app-touches`}>Everything it touches</a> is written down.
        </p>
      </section>

      <section class="end" id="pricing">
        <h2>Free for personal use. $29 for work.</h2>
        <div class="plans">
          <div class="plan">
            <h3>Personal</h3>
            <p class="price">Free</p>
            <ul>
              <li>The whole app, every feature, signed and self-updating</li>
              <li>Side projects, learning, open source in your own time</li>
              <li>Or build it from the source yourself</li>
            </ul>
            <a class="btn" href={DOWNLOAD_URL}>Download for Mac</a>
          </div>
          <div class="plan pro-plan">
            <h3>Commercial</h3>
            <p class="price">{PRICE} per person, one time</p>
            <ul>
              <li>Any paid work, freelance and client work included</li>
              <li>One licence per person, on every Mac they own or control</li>
              <li>Try it at work for 30 days first</li>
            </ul>
            {BUY_URL ? (
              <a class="btn primary" href={BUY_URL}>Buy a licence</a>
            ) : (
              <span class="btn primary disabled" aria-disabled="true">Available soon</span>
            )}
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a href={`${base}guide/install/`}>Docs</a>
      <a href={`${base}reference/keys/`}>Keys</a>
      <a href={SOURCE_URL}>Source</a>
    </footer>

    <script>
      // The film waits for a click: nothing on the page moves on its own
      // besides the hero's one lighting-up moment. The iframe is only given
      // its src on that click, so nothing of the film loads before it.
      const film = document.querySelector<HTMLIFrameElement>('.film iframe');
      const play = document.querySelector<HTMLButtonElement>('.film .play');
      play?.addEventListener('click', () => {
        if (!film) return;
        film.src = film.dataset.src ?? '';
        play.remove();
        film.focus();
      });
      // Install methods: three tabs over three panels, arrows move between
      // tabs as a tablist should. A copy button copies the code beside it and
      // says so in its own label for a moment; that is the confirmation.
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.methods [role=tab]')];
      const pick = (t: HTMLButtonElement) => {
        for (const o of tabs) {
          const on = o === t;
          o.setAttribute('aria-selected', String(on));
          o.tabIndex = on ? 0 : -1;
          document.getElementById(o.getAttribute('aria-controls') ?? '')?.toggleAttribute('hidden', !on);
        }
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => pick(t));
        t.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          pick(next);
          next.focus();
        });
      });
      for (const b of document.querySelectorAll<HTMLButtonElement>('.install .copy')) {
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.previousElementSibling?.textContent ?? '');
            b.textContent = 'Copied';
          } catch {
            b.textContent = 'Select it';
          }
          setTimeout(() => (b.textContent = 'Copy'), 1600);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* The canvas: a cool pale grey with a dot grid, the app's canvas lit up. */
    --canvas: #e7e6ee;
    --dot: #c9c7d6;
    --ink: #17161f;
    --ink-soft: #4a4858;
    /* A terminal card in Violite, the app's default theme. */
    --card: #241c36;
    --card-edge: #3d2f5c;
    --card-text: #eef4f6;
    --card-dim: #8a7cab;
    /* The four states, the app's own values (chrome.rs). */
    --working: #9d7cd8;
    --waiting: #ffc400;
    --failed: #e5484d;
    --done: #4fb477;

    --sans: 'Schibsted Grotesk Variable', system-ui, sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --canvas: #121119;
      --dot: #2a2837;
      --ink: #ecebf5;
      --ink-soft: #a6a4b8;
      --card: #241c36;
      --card-edge: #3d2f5c;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --canvas: #121119;
    --dot: #2a2837;
    --ink: #ecebf5;
    --ink-soft: #a6a4b8;
    --card-edge: #3d2f5c;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background-color: var(--canvas);
    background-image: radial-gradient(var(--dot) 1.2px, transparent 1.4px);
    background-size: 24px 24px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.125rem;
    line-height: 1.55;
    overflow-x: clip;
  }
  html { overflow-x: clip; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--working); outline-offset: 3px; border-radius: 4px; }
  kbd {
    font: 600 0.8em var(--mono);
    padding: 0.1em 0.45em;
    border: 1px solid var(--ink-soft);
    border-bottom-width: 2px;
    border-radius: 5px;
    white-space: nowrap;
  }

  .top, main > section, footer {
    width: min(1180px, 100% - 32px);
    margin-inline: auto;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 20px;
  }
  .mark { display: flex; gap: 10px; align-items: center; font-weight: 700; font-size: 1.15rem; text-decoration: none; }
  .mark img { border-radius: 6px; }
  .top nav { display: flex; gap: 24px; font-weight: 500; }
  .top nav a { text-decoration: none; }
  .top nav a:hover { text-decoration: underline; }

  h1, h2 { font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; margin: 0; }
  h1 { font-size: clamp(2.6rem, 5.6vw, 4.8rem); max-width: 14ch; }
  h2 { font-size: clamp(1.9rem, 3.8vw, 3rem); max-width: 20ch; }
  p { max-width: 62ch; }

  /* Hero: copy on the left, a stretch of canvas running off the right edge. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 40px;
    align-items: center;
    padding-block: 40px 96px;
  }
  .lede { font-size: 1.25rem; color: var(--ink-soft); margin: 28px 0 32px; }
  .methods { display: flex; gap: 4px; margin-bottom: 8px; }
  .methods button {
    font: 600 0.9rem var(--sans);
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-radius: 7px;
    padding: 7px 12px;
    cursor: pointer;
  }
  .methods button[aria-selected='true'] { color: var(--ink); background: color-mix(in srgb, var(--ink) 10%, transparent); }
  .install[hidden] { display: none; }
  .install.dmg { align-items: center; justify-content: space-between; padding-left: 16px; font-size: 0.95rem; }
  .install.dmg a {
    align-self: stretch;
    display: flex;
    align-items: center;
    padding: 0 20px;
    font-weight: 600;
    text-decoration: none;
    background: var(--working);
    color: #17161f;
  }
  .install {
    display: flex;
    align-items: stretch;
    /* The same height for all three tabs, so switching them does not shift the page. */
    min-height: 50px;
    max-width: 640px;
    background: var(--card);
    color: var(--card-text);
    border-radius: 10px;
    border: 1px solid var(--card-edge);
    overflow: hidden;
  }
  .install code {
    flex: 1;
    min-width: 0;
    font: 0.86rem/1.4 var(--mono);
    padding: 15px 16px;
    overflow-x: auto;
    white-space: nowrap;
  }
  .install code::before { content: '$ '; color: var(--card-dim); }
  .install button {
    font: 600 0.9rem var(--sans);
    background: var(--working);
    color: #17161f;
    border: 0;
    padding: 0 20px;
    cursor: pointer;
    min-width: 92px;
  }
  .install button:hover { background: #b39ae3; }
  .btn {
    display: inline-block;
    font: 600 1rem var(--sans);
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 9px;
    border: 1.5px solid var(--ink);
    color: var(--ink);
  }
  .btn:hover { text-decoration: none; background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .btn.primary { background: var(--working); border-color: var(--working); color: #17161f; }
  .btn.primary:hover { background: #b39ae3; }
  .btn.disabled { opacity: 0.55; cursor: default; }
  .btn.disabled:hover { background: var(--working); }
  .fine { font-size: 0.95rem; color: var(--ink-soft); margin-top: 14px; }

  /* Wider than its column on purpose: it runs off the window's right edge,
     because the canvas does not end. The near card is the one you zoomed to:
     twice the size and readable, where the far ones are bars. */
  .hero-canvas {
    display: grid;
    grid-template-columns: repeat(6, 168px);
    grid-auto-rows: 104px;
    grid-auto-flow: dense;
    gap: 14px;
    width: max-content;
  }
  .hero-canvas .near { grid-column: span 2; grid-row: span 2; padding: 30px 18px 16px; }
  .hero-canvas .near pre { font-size: 14px; line-height: 1.55; }
  .hero-canvas .near .label { font-size: 12px; top: 9px; left: 14px; }
  .card {
    background: var(--card);
    color: var(--card-text);
    border-radius: 7px;
    border: 1px solid var(--card-edge);
    position: relative;
    overflow: hidden;
  }
  .hero-canvas .card { padding: 22px 12px 10px; }
  .card .label {
    position: absolute;
    top: 6px;
    left: 10px;
    font: 500 10px var(--mono);
    color: var(--card-dim);
  }
  .bars { display: grid; gap: 6px; }
  .bars i { display: block; height: 4px; max-width: 100%; border-radius: 2px; background: #56447a; }
  .card pre {
    margin: 0;
    font: 11px/1.45 var(--mono);
    white-space: pre;
    overflow: hidden;
  }

  /* A card's state is its border, as in the app: 3px in the state's hue. */
  .s-working.card, .s-working .card { box-shadow: 0 0 0 3px var(--working); }
  .s-waiting.card, .s-waiting .card { box-shadow: 0 0 0 3px var(--waiting); }
  .s-failed.card, .s-failed .card { box-shadow: 0 0 0 3px var(--failed); }
  .s-done.card, .s-done .card { box-shadow: 0 0 0 3px var(--done); }
